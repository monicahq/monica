#
# Monica Portable App Configuration
# Optimiert für USB-Stick und Windows ohne Admin-Rechte
#

APP_NAME=Monica
APP_ENV=production
APP_KEY=base64:SomeRandomKeyWillBeGeneratedBySetupScript==
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# Deaktiviere Signups für Single-User Portable Version
APP_DISABLE_SIGNUP=true

# SQLite Database - Portable und ohne Installation
DB_CONNECTION=sqlite
# DB_DATABASE wird automatisch auf ./database/database.sqlite gesetzt

# Logs
LOG_CHANNEL=single

# Cache und Session im File-System (keine externe DB nötig)
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Mail deaktiviert für Offline-Betrieb
MAIL_MAILER=log

# Search mit Database-Driver (keine externen Services)
SCOUT_DRIVER=database
SCOUT_QUEUE=false
FULL_TEXT_INDEX=true

# Keine externen Services für Offline-Betrieb
DEFAULT_STORAGE_LIMIT=0
UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_PRIVATE_KEY=
LOCATION_IQ_API_KEY=
MAPBOX_API_KEY=
MAPBOX_USERNAME=
