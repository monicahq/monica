#
# Welcome, friend ❤. Thanks for trying out Monica. We hope you'll have fun.
#
# This file contains all the configuration options for Monica. Copy it to .env
# and change the values there. If you need to change a core component of the
# app, do it here. However, you might need to restart the web server, and run
# `php artisan config:clear` if the configuration is cached, for some of these
# values to be taken into account.

# The name of your application. This is used as the default title of the pages.
APP_NAME=Monica

# Two choices: local|production. Use local if you want to install Monica as a
# development version. Use production otherwise.
APP_ENV=local

# The encryption key. This is the most important part of the application. Keep
# this secure otherwise, everyone will be able to access your application.
# Use `php artisan key:generate` or
# `echo -n 'base64:'; openssl rand -base64 32` to generate a random key.
APP_KEY=

# true if you want to show debug information on errors, or if you need to debug
# locally. For production, put this to false.
APP_DEBUG=true

# The URL of your application.
APP_URL=http://localhost

# Comma separated regular expressions naming the hosts this instance answers on,
# besides the host of APP_URL and its subdomains. Leave it empty to answer on
# every host. Once it is set, a request for any other host is refused.
# APP_TRUSTED_HOSTS=^monica\.example\.com$,^contacts\.example\.org$

# Comma separated addresses or ranges of the proxies in front of this instance,
# whose forwarded headers are believed. Use * to believe whichever one connects.
# This is what lets the application build https links behind a reverse proxy.
# APP_TRUSTED_PROXIES=10.0.0.0/8

# Set to true when the instance is served through Cloudflare. Its address ranges
# are then trusted next to APP_TRUSTED_PROXIES, kept in the cache and refreshed
# every day. Run php artisan cloudflare:reload after changing either setting.
LARAVEL_CLOUDFLARE_ENABLED=false

# The debug bar follows APP_DEBUG unless this says otherwise, which is what you
# want when debugging something the bar itself gets in the way of.
DEBUGBAR_ENABLED=true

# The number of workers `php artisan serve` starts, for local development only.
# PHP_CLI_SERVER_WORKERS=4

# Logs
# Logs are written when an error occurs. Refer to config/logging.php for the
# possible channels and levels. In production, a level of error or warning
# keeps the files small.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laravel Nightwatch watches requests, jobs, queries and exceptions from its
# dashboard, which is where the token comes from. Nothing leaves while it is
# off. While it is on, its agent has to run next to the application:
# php artisan nightwatch:agent
NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=
# The share of requests that opens a trace. 1.0 keeps every request, which is
# right while trying it out, and 0.1 is the recommended start in production. A
# request that throws is kept whatever the rate. The admin space is always kept,
# unmatched addresses and the API status check one time in a hundred, and the
# health check never.
NIGHTWATCH_REQUEST_SAMPLE_RATE=1.0
# A form submitted here is somebody's address book, so what a request carried
# stays out of its trace even when the request throws.
NIGHTWATCH_CAPTURE_REQUEST_PAYLOAD=false

# Database to store information
# sqlite needs nothing else: the database is a file in the database folder.
# For mysql, mariadb or pgsql, uncomment the lines below and fill them in.
# You can see the different values you can use in config/database.php
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Sessions
# How long, in minutes, a session lasts without activity, and whether its
# content is encrypted. SESSION_DOMAIN is only needed to share the session
# cookie with subdomains.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting, storage and queue
# ⚠ Change this only if you know what you are doing
#. Filesystem: local, s3 (fill in the AWS settings below)
#. Queue: sync, database, beanstalkd, sqs, redis
#  If Queue is not set to 'sync', you'll have to run a queue worker:
#  php artisan queue:work
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Cache
# ⚠ Change this only if you know what you are doing
#. Cache: database, file, memcached, redis, dynamodb
# CACHE_PREFIX is only needed when several applications share the same store.
CACHE_STORE=database
# CACHE_PREFIX=

# Memcached, if you use it for the cache or the sessions
MEMCACHED_HOST=127.0.0.1

# Redis, if you use it for the cache, the sessions or the queues
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailing
# Set the MAIL_MAILER to 'smtp' if you want to send emails. 'log' writes them
# to the log file instead, which is handy for local development.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# To use Resend, set `MAIL_MAILER=resend` and add its api key here:
RESEND_API_KEY=

# The signing secret of the Resend webhook, from its dashboard. Without it the
# delivery reports Resend sends cannot be proven, so none of them is acted on.
RESEND_WEBHOOK_SECRET=

# Features of this instance
# Can be true or false. config/monica.php describes each of them.
#. MONICA_REGISTRATION_ENABLED: whether somebody may create an account. Whoever
#  already has an account is not affected.
#. MONICA_SUPPORT_ENABLED: whether people may ask the administrators of this
#  instance for help from inside the application.
#. MONICA_CHANGELOG_ENABLED: whether the instance shows What's new, the
#  changelog of Monica, with its votes and comments.
#. MONICA_SEARCH_ENGINE_INDEXING: whether search engines may list the pages
#  anybody can read: the documentation, the guide and the marketplace.
#. MONICA_SELF_HOSTED: whether this instance runs outside of the cloud one. An
#  account on a self hosted instance has no storage ceiling and no rate limit.
MONICA_REGISTRATION_ENABLED=true
MONICA_SUPPORT_ENABLED=false
MONICA_CHANGELOG_ENABLED=false
MONICA_SEARCH_ENGINE_INDEXING=true
MONICA_SELF_HOSTED=true

# Stripe, from its dashboard. The webhook secret is what proves a confirmation
# came from Stripe, so without it no payment ever unlocks anything.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# The currency an amount is quoted in when nothing has picked one.
CASHIER_CURRENCY=eur

# Notification channels
# Email always works. The channels below are optional, each with its own
# provider account.

# Vonage, for the text message channel. The integration is optional: install
# it with `composer require laravel/vonage-notification-channel`. Without it the
# channel is listed and says it is unavailable on this server. This is the
# instance's own provider account: an account holder supplies the number to
# send to, never these, and whoever runs the server pays for what goes out.
# Leave them empty and the channel simply never delivers. VONAGE_SMS_FROM is
# the sender the recipient sees, and some countries refuse anything that is not
# a real number.
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=

# Telegram, for the Telegram channel. The integration is optional: install it
# with `composer require laravel-notification-channels/telegram`. Without it the
# channel is listed and says it is unavailable on this server. The bot is the
# instance's, not an account holder's: they follow a link to it and press
# Start, and the webhook records which conversation that was. BOT_URL is the
# public address of the bot, such as https://t.me/YourBot. The webhook secret
# is what proves a call really came from Telegram; generate one with:
# openssl rand -hex 32
# Register the webhook once with: php artisan monica:setup-telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_URL=
TELEGRAM_BOT_WEBHOOK_SECRET=

# A signed link that signs you in, so a screenshot tool that can only open a
# URL can reach a screen behind the sign in. It only works when APP_ENV is a
# development one, when this is true, and when the instance answers on
# localhost, a loopback address or a .test host, and the link itself is signed
# with APP_KEY and expires. Leave it off unless you are taking screenshots.
MONICA_SCREENSHOT_LINK_ENABLED=false
MONICA_SCREENSHOT_LINK_LIFETIME_IN_MINUTES=5

# The oldest version of the Android app this instance still works with, such as
# 1.2.0. An older app asks the person to update it before signing in. Leave it
# empty to accept every version.
MONICA_MINIMUM_ANDROID_VERSION=

# Search
## We use Laravel Scout to do full-text search.
## Read config/scout.php for more information.
## database searches this database and needs nothing else, but does not
## tolerate typing mistakes. algolia, meilisearch and typesense do, each with
## its client installed (see the suggestions in composer.json). null keeps
## search unavailable and everything else works.
## After choosing an engine, run: php artisan monica:rebuild-search-index
## and, when changing engines, name the one searched until now with --from.
SCOUT_DRIVER=database
## If you never intend to use the 'database' driver, you can set this to false:
# FULL_TEXT_INDEX=true
## A prefix for the index names, when several instances share the same engine.
SCOUT_PREFIX=
## Set to true to index in the background. This requires a queue worker.
SCOUT_QUEUE=false
# SCOUT_QUEUE_CONNECTION=redis
## Meilisearch settings
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=
## Typesense settings
# TYPESENSE_HOST=localhost
# TYPESENSE_API_KEY=
## Algolia settings
# ALGOLIA_APP_ID=
# ALGOLIA_SECRET=

# Cloudflare Turnstile, to keep robots away from the public forms.
# The keys come from the Cloudflare dashboard.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Amazon S3, or any S3 compatible storage, to store files when
# FILESYSTEM_DISK=s3. Set AWS_USE_PATH_STYLE_ENDPOINT to true for providers
# such as MinIO.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# The name of the application, as the frontend build sees it.
VITE_APP_NAME="${APP_NAME}"

# Signing in through an outside provider. Leave a setting empty and that provider
# is not offered. Register /sso/{name}/callback at the provider, where {name} is
# github, google, apple, entra, facebook, keycloak, auth0, okta or openidconnect.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple needs `composer require socialiteproviders/apple`. APPLE_PRIVATE_KEY is the text
# of the .p8 key, on one line if need be, or the path to the file. Without a key,
# APPLE_CLIENT_SECRET takes a secret generated in advance, which lasts six months at most.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_SECRET=
# ENTRA_TENANT names the one organisation that may sign in. "common" accepts any Microsoft account.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT=common
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# OKTA_AUTH_SERVER is needed only for a custom authorization server.
OKTA_DOMAIN=
OKTA_AUTH_SERVER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# Any other OpenID Connect provider (Authentik, Zitadel, Authelia). OIDC_BASE_URL is
# its https address, and OIDC_NAME is the name shown on the button.
OIDC_BASE_URL=
OIDC_NAME=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
