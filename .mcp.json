{
  "mcpServers": {
    "laravel-boost": {
      "command": "php",
      "args": [
        "artisan",
        "boost:mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "nightwatch": {
      "type": "http",
      "url": "https://nightwatch.laravel.com/mcp"
    },
    "sonarqube": {
      "type": "http",
      "url": "https://api.sonarcloud.io/mcp"
    }
  }
}