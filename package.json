{
  "private": true,
  "scripts": {
    "dev": "npm run development",
    "development": "mix",
    "predevelopment": "php artisan lang:generate -vvv",
    "watch": "mix watch",
    "prewatch": "php artisan lang:generate -vvv",
    "watch-poll": "mix watch -- --watch-options-poll=1000",
    "hot": "mix watch --hot",
    "prod": "npm run production",
    "production": "mix --production",
    "preproduction": "php artisan lang:generate -vvv",
    "heroku-postbuild": "npm run production",
    "e2e": "cypress run",
    "e2e:chrome": "cypress run --browser chrome",
    "e2e:record": "cypress run --record",
    "e2e:record:parallel": "cypress run --record --parallel",
    "e2e-gui": "cypress open",
    "cy:verify": "cypress verify",
    "cy:version": "cypress version",
    "inst": "npm ci",
    "lint": "eslint --ext .js,.vue *.js .*.js resources/js/",
    "lint:cypress": "eslint --ext .js tests/cypress/",
    "lint:all": "npm run lint & npm run lint:cypress",
    "lint:fix": "npm run lint -- --fix & npm run lint:cypress -- --fix",
    "snyk-protect": "snyk-protect",
    "prepublish": "npm run snyk-protect",
    "delete:reports": "rm results/cypress/* || true",
    "pree2e": "npm run delete:reports",
    "migrate": "DB_CONNECTION=testing php artisan migrate:fresh && DB_CONNECTION=testing php artisan db:seed",
    "pretest": "npm run migrate",
    "test": "vendor/bin/phpunit",
    "posttest": "vendor/bin/phpstan analyse && vendor/bin/psalm",
    "composer update": "COMPOSER_MEMORY_LIMIT=-1 composer update"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10.0"
  },
  "devDependencies": {
    "@snyk/protect": "^1.1296.0",
    "cross-env": "^7.0",
    "cypress": "^13.0",
    "eslint": "^8.57",
    "eslint-config-standard": "^17.1",
    "eslint-plugin-cypress": "^3.5",
    "eslint-plugin-import": "^2.31",
    "eslint-plugin-node": "^11.1",
    "eslint-plugin-promise": "^6.6",
    "eslint-plugin-standard": "^5.0",
    "eslint-plugin-vue": "^7.20",
    "faker": "^5.5",
    "mocha": "^10.8",
    "mocha-junit-reporter": "^2.2",
    "mocha-multi-reporters": "^1.5",
    "moment-locales-webpack-plugin": "^1.2",
    "postcss": "^8.5",
    "resolve-url-loader": "^5.0",
    "laravel-mix": "^6.0",
    "laravel-mix-purgecss": "^6.0",
    "sass": "^1.82",
    "sass-loader": "^16.0",
    "vue-loader": "^15.11",
    "vue-template-compiler": "^2.7"
  },
  "dependencies": {
    "@hokify/vuejs-datepicker": "^2.0",
    "animate.css": "^4.1",
    "axios": "^1.7",
    "bootstrap": "^4.6",
    "font-awesome": "^4.7",
    "hint.css": "^2.7",
    "jquery": "^3.7",
    "list.js": "^2.3",
    "lodash": "^4.17",
    "marked": "^14.0",
    "moment": "^2.30",
    "moment-timezone": "^0.5",
    "popper.js": "^1.16",
    "pretty-checkbox-vue": "^1.1",
    "rx-js": "^0.0.0",
    "sweet-modal-vue": "^2.0",
    "tachyons": "^4.12",
    "vue": "^2.7",
    "vue-autosuggest": "^2.2",
    "vue-checkbox-radio": "^0.6",
    "vue-clipboard2": "^0.3",
    "vue-directive-tooltip": "^1.6",
    "vue-good-table": "^2.21",
    "vue-i18n": "^8.28",
    "vue-js-toggle-button": "^1.3",
    "vue-notification": "^1.3",
    "vue-rx": "^6.2",
    "vue-select": "^3.20",
    "vuejs-clipper": "4.0.0",
    "vuelidate": "^0.7"
  },
  "overrides": {
    "webpack": "5.74.0",
    "webpack-cli": "4.10.0"
  },
  "snyk": true
}
