APP_NAME=Monica
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Comma separated regular expressions naming the hosts this instance answers on,
# besides the host of APP_URL and its subdomains. Leave it empty to answer on
# every host. Once it is set, a request for any other host is refused.
# APP_TRUSTED_HOSTS=^monica\.example\.com$,^contacts\.example\.org$

# Comma separated addresses or ranges of the proxies in front of this instance,
# whose forwarded headers are believed. Use * to believe whichever one connects.
# APP_TRUSTED_PROXIES=10.0.0.0/8

# Set to true when the instance is served through Cloudflare. Its address ranges
# are then trusted next to APP_TRUSTED_PROXIES, kept in the cache and refreshed
# every day. Run php artisan cloudflare:reload after changing either setting.
LARAVEL_CLOUDFLARE_ENABLED=false

# The debug bar follows APP_DEBUG unless this says otherwise, which is what you
# want when debugging something the bar itself gets in the way of.
DEBUGBAR_ENABLED=true

# PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# To use Resend, set `MAIL_MAILER=resend` and add its api key here:
RESEND_API_KEY=

# The signing secret of the Resend webhook, from its dashboard. Without it the
# delivery reports Resend sends cannot be proven, so none of them is acted on.
RESEND_WEBHOOK_SECRET=

MONICA_REGISTRATION_ENABLED=true
MONICA_SELF_HOSTED=true

# Stripe, from its dashboard. The webhook secret is what proves a confirmation
# came from Stripe, so without it no payment ever unlocks anything.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# The currency an amount is quoted in when nothing has picked one.
CASHIER_CURRENCY=eur

# Vonage, for the text message channel. The integration is optional: install
# it with `composer require laravel/vonage-notification-channel`. Without it the
# channel is listed and says it is unavailable on this server. This is the instance's own provider
# account: an account holder supplies the number to send to, never these, and
# whoever runs the server pays for what goes out. Leave them empty and the
# channel simply never delivers. VONAGE_SMS_FROM is the sender the recipient
# sees, and some countries refuse anything that is not a real number.
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM=

# Telegram, for the Telegram channel. The integration is optional: install it
# with `composer require laravel-notification-channels/telegram`. Without it the
# channel is listed and says it is unavailable on this server. The bot is the instance's, not an account
# holder's: they follow a link to it and press Start, and the webhook records
# which conversation that was. BOT_URL is the public address of the bot, such
# as https://t.me/YourBot. The webhook secret is what proves a call really came
# from Telegram; generate one with: openssl rand -hex 32
# Register the webhook once with: php artisan monica:setup-telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_URL=
TELEGRAM_BOT_WEBHOOK_SECRET=

# A signed link that signs you in, so a screenshot tool that can only open a URL can reach a screen
# behind the sign in. It only works when APP_ENV is a development one, when this is true, and when
# the instance answers on localhost, a loopback address or a .test host, and the link itself is
# signed with APP_KEY and expires. Leave it off unless you are taking screenshots.
MONICA_SCREENSHOT_LINK_ENABLED=false
MONICA_SCREENSHOT_LINK_LIFETIME_IN_MINUTES=5

# Search, through Laravel Scout. database searches this database and needs
# nothing else, but does not tolerate typing mistakes. algolia, meilisearch and
# typesense do, each with its client installed (see the suggestions in
# composer.json). null keeps search unavailable and everything else works.
# After choosing an engine, run: php artisan monica:rebuild-search-index
# and, when changing engines, name the one searched until now with --from.
SCOUT_DRIVER=database
# FULL_TEXT_INDEX=true
SCOUT_PREFIX=
SCOUT_QUEUE=false
# SCOUT_QUEUE_CONNECTION=redis
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=
# TYPESENSE_HOST=localhost
# TYPESENSE_API_KEY=
# ALGOLIA_APP_ID=
# ALGOLIA_SECRET=

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Signing in through an outside provider. Leave a client empty and that provider
# is not offered. Microsoft also needs socialiteproviders/microsoft installed.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
