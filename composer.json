{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "monicahq/monica",
    "type": "project",
    "description": "Monica is a personal relationship manager.",
    "keywords": [
        "laravel",
        "crm",
        "prm",
        "social"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Regis Freyd",
            "homepage": "https://github.com/djaiss"
        },
        {
            "name": "Alexis Saettler",
            "homepage": "https://github.com/asbiin"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "aws/aws-sdk-php": "^3.399",
        "bacon/bacon-qr-code": "^3.1",
        "erag/laravel-disposable-email": "^5.2",
        "intervention/image": "^4.0",
        "laravel/cashier": "^16.8",
        "laravel/framework": "^13.8",
        "laravel/mcp": "^1.0",
        "laravel/passkeys": "^0",
        "laravel/passport": "^13.8",
        "laravel/pennant": "^1.26",
        "laravel/sanctum": "^4.3",
        "laravel/scout": "^11.8",
        "laravel/socialite": "^5.31",
        "laravel/telescope": "^5.25",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35",
        "monicahq/laravel-sabre": "^2.0",
        "php-http/discovery": "^1.20",
        "pragmarx/google2fa-laravel": "^3.0",
        "resend/resend-laravel": "^1.4",
        "sentry/sentry-laravel": "^4.27",
        "spatie/laravel-login-link": "^1.6",
        "stevebauman/purify": "^6.3"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "brianium/paratest": "^7.20",
        "fakerphp/faker": "^1.23",
        "http-interop/http-factory-guzzle": "^1.2",
        "larastan/larastan": "^3.9.2",
        "laravel-lang/common": "^6.8",
        "laravel-notification-channels/telegram": "^8.0",
        "laravel/boost": "^2.5",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.68",
        "laravel/vonage-notification-channel": "^3.3",
        "meilisearch/meilisearch-php": "^1.17",
        "mockery/mockery": "^1.6",
        "monicahq/laradb": "^1.1",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12",
        "socialiteproviders/microsoft": "^4.10",
        "typesense/typesense-php": "^6.0"
    },
    "suggest": {
        "laravel-notification-channels/telegram": "Required to send notifications over Telegram. Without it the channel is listed and reports itself unavailable.",
        "algolia/algoliasearch-client-php": "Required to search with Algolia. Search needs one typo tolerant engine: Algolia, Meilisearch or Typesense.",
        "laravel/vonage-notification-channel": "Required to send notifications by text message. Without it the channel is listed and reports itself unavailable.",
        "meilisearch/meilisearch-php": "Required to search with Meilisearch, together with http-interop/http-factory-guzzle. Search needs one typo tolerant engine: Algolia, Meilisearch or Typesense.",
        "socialiteproviders/microsoft": "Required to offer Microsoft as a way to sign in. GitHub, Google and Facebook need nothing beyond laravel/socialite.",
        "typesense/typesense-php": "Required to search with Typesense. Search needs one typo tolerant engine: Algolia, Meilisearch or Typesense."
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "bunx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --queue=high,default,low --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"bun run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test --parallel"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php -r \"symlink('.claude/CLAUDE.md', './CLAUDE.md');\" || true",
            "@php artisan boost:update --ansi --no-interaction --no-discover || true",
            "@php -r \"unlink('./CLAUDE.md');\" || true"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
